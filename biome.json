{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/migrations"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["web/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error",
            "noNestedComponentDefinitions": "error",
            "noComponentHookFactories": "error"
          },
          "suspicious": {
            "noArrayIndexKey": "error",
            "noExplicitAny": "error"
          },
          "security": {
            "noDangerouslySetInnerHtml": "error"
          }
        }
      }
    },
    {
      "includes": ["web/src/ui/Table.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    }
  ]
}
