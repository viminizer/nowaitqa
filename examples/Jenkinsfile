// Example: run nowait-qa tests from an app's Jenkins pipeline.
// Copy the 'Mobile tests' stage (and the parameter and environment lines it uses) into the app's
// Jenkinsfile, after the stage that builds the APK.
//
// Needs in Jenkins:
// - a "Secret text" credential with id 'nowait-trigger-token' holding the server's TRIGGER_TOKEN
// - curl and Node.js on the agent
pipeline {
  agent any

  parameters {
    choice(name: 'RELEASE_POLICY', choices: ['permissive', 'strict'], description: 'Saved release policy for this run')
    booleanParam(
      name: 'WAIT_FOR_RESULT',
      defaultValue: true,
      description: 'Wait for the mobile tests and fail the build if they fail',
    )
  }

  environment {
    NOWAIT_URL = 'http://qa-server:3000' // the nowait-qa server
    // Appium on the test machine downloads the APK from here, so the test machine must be able
    // to reach this URL without logging in to Jenkins.
    APK_URL = "${env.BUILD_URL}artifact/app/build/outputs/apk/debug/app-debug.apk"
  }

  stages {
    stage('Build') {
      steps {
        sh './gradlew assembleDebug'
        archiveArtifacts artifacts: 'app/build/outputs/apk/debug/app-debug.apk'
      }
    }

    stage('Mobile tests') {
      steps {
        // Bounds the whole stage, including the wait. Keep it longer than the slowest run: the
        // server already ends stuck runs (STUCK_RUN_MINUTES).
        timeout(time: 90, unit: 'MINUTES') {
          withCredentials([string(credentialsId: 'nowait-trigger-token', variable: 'NOWAIT_TOKEN')]) {
            sh '''
              set -eu
              # No commit: the run uses the scenarios the runner sent last. Add "commit" to pin one.
              RUN=$(curl -sf -X POST "$NOWAIT_URL/runs" \
                -H "Authorization: Bearer $NOWAIT_TOKEN" -H "Content-Type: application/json" \
                -d "{\\"platform\\":\\"android\\",\\"appBuild\\":\\"$APK_URL\\",\\"releasePolicy\\":\\"$RELEASE_POLICY\\",\\"trigger\\":\\"jenkins $JOB_NAME #$BUILD_NUMBER\\"}")
              RUN_ID=$(echo "$RUN" | sed 's/.*"id":\\([0-9]*\\).*/\\1/')
              echo "nowait-qa run $RUN_ID started"
              [ "$WAIT_FOR_RESULT" = true ] || exit 0

              # Consume the server's saved gate; raw execution status still reports retries.
              while true; do
                RESPONSE=$(curl -sf -H "Authorization: Bearer $NOWAIT_TOKEN" "$NOWAIT_URL/runs/$RUN_ID")
                GATE=$(printf '%s' "$RESPONSE" | node -e 'let text="";process.stdin.on("data",d=>text+=d);process.stdin.on("end",()=>{const r=JSON.parse(text);if(!r.release)throw Error("upgrade server: release gate unavailable");console.log(r.release.gate.status)})')
                [ "$GATE" = pending ] || break
                sleep 30
              done
              echo "nowait-qa run $RUN_ID release gate: $GATE"
              [ "$GATE" = accepted ]
            '''
          }
        }
      }
    }
  }
}
