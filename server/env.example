DATABASE_URL=postgres://nowait:nowait@localhost:5432/nowait
# At least 16 characters each. Generate one: openssl rand -hex 24
# The runner's token: can call every route.
RUNNER_TOKEN=
# Jenkins' token: can only start a run and read it.
TRIGGER_TOKEN=
# The dashboard's password (basic auth, any user name). At least 16 characters.
DASHBOARD_PASSWORD=
PORT=3000
LEASE_SECONDS=120
# A run fails when no phone of its platform took or finished work for this long.
STUCK_RUN_MINUTES=15
MAX_ATTEMPTS=2
ARTIFACT_DIR=artifacts
ARTIFACT_DAYS=30
