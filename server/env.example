DATABASE_URL=postgres://nowait:nowait@localhost:5432/nowait
# At least 16 characters each. Generate one: openssl rand -hex 24
# The runner's token: can call every route.
RUNNER_TOKEN=
# Jenkins' token: can only start a run and read it.
TRIGGER_TOKEN=
# The dashboard's password (basic auth, any user name). At least 16 characters.
DASHBOARD_PASSWORD=
PORT=3000
LEASE_SECONDS=120
# A run fails when no phone of its platform took or finished work for this long.
STUCK_RUN_MINUTES=15
MAX_ATTEMPTS=2
# Screenshots and logs: on this disk under ARTIFACT_DIR, or in S3 when S3_BUCKET is set.
ARTIFACT_DIR=artifacts
ARTIFACT_DAYS=30
# S3_BUCKET=nowait-artifacts
# S3_REGION=us-east-1
# For RustFS or MinIO (the local test: docker compose --profile s3 up -d)
# S3_ENDPOINT=http://localhost:9000
# Set both, or neither (then the SDK finds credentials itself, like an IAM role on AWS)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# The server's address as people open it, for links in chat messages
# PUBLIC_URL=https://qa.example.com
# Slack: a message per finished run, failures with screenshots in its thread. Set both, or neither.
# A Slack app bot token (xoxb-...) with the chat:write and files:write scopes, added to the channel.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=#qa
# Telegram: a bot in a group with topics. Set both, or neither.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=-1001234567890
# Topic ids (message_thread_id). Runs: every run's summary. Errors: each failed scenario with its
# screenshot. No runs topic = the group's General topic; no errors topic = replies to the summary.
# TELEGRAM_RUNS_TOPIC=
# TELEGRAM_ERRORS_TOPIC=
