{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "shared/src",
    "server/src",
    "server/drizzle.config.ts",
    "runner/src",
    "cli/src",
    "sdk",
    "examples/scenarios",
    "scripts"
  ],
  "exclude": ["**/node_modules"]
}
