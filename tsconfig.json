{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["shared/src", "server/src", "server/drizzle.config.ts", "runner/src", "scenarios"],
  "exclude": ["**/node_modules"]
}
