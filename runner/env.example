SERVER_URL=http://localhost:3000
# Same token as the server's RUNNER_TOKEN
RUNNER_TOKEN=
# This machine's name, as used in the devices table
HOST=macmini-1
# Guided virtual-device setup (manual registrations keep their own Appium URL).
APPIUM_URL=http://127.0.0.1:4723
# ANDROID_HOME=/path/to/Android/sdk
# ANDROID_SDK_ROOT=/path/to/Android/sdk
# ANDROID_AVD_HOME=/path/to/.android/avd
# Defaults: SDK platform-tools/adb and emulator/emulator, or adb/emulator on PATH.
# ADB_BIN=/path/to/adb
# EMULATOR_BIN=/path/to/emulator
# APPIUM_BIN=appium
# XCRUN_BIN=xcrun
# Shared password of the test accounts in the pool (only needed when the pool has accounts)
TEST_ACCOUNT_PASSWORD=
# Folder of scenario files, inside a git checkout. Use an absolute path.
# Default: examples/scenarios in this repo
# SCENARIOS_DIR=/path/to/your/scenarios
# Let the runner pull the scenarios itself (then SCENARIOS_DIR is required: an empty folder)
# SCENARIOS_REPO=git@github.com:your-company/your-scenarios.git
# SCENARIOS_BRANCH=main
# Managed-cache admission limits. Active/reference-held checkouts are never evicted to fit.
# One managed SCENARIOS_DIR per runner process; shared package stores are managed by pnpm.
# SCENARIO_CACHE_REVISIONS=10
# SCENARIO_CACHE_BYTES=5368709120
SCENARIO_TIMEOUT_SECONDS=600
# Maximum verified app/ignored-code bytes (1 MiB–1 GiB). Appium must share the runner filesystem.
INPUT_MAX_BYTES=536870912
# reuse: one session per phone/run; fresh: a new session for every scenario attempt
SESSION_MODE=reuse
